{
  "name": "big-stuff-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:public": "vite --host 127.0.0.1",
    "dev:admin": "vite --host 127.0.0.1 admin.html",
    "admin": "tsx scripts/admin-server.ts",
    "import": "tsx scripts/import-photos.ts",
    "build:data": "tsx scripts/build-public-data.ts",
    "build:markers": "tsx scripts/generate-marker-derivatives.ts",
    "build:site": "vite build",
    "build": "npm run build:data && npm run build:markers && npm run build:site",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
